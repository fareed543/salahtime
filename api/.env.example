YII_ENV=local
YII_DEBUG=true

# Required on dev/prod for reliable email delivery.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# Required to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_STATE_KEY=

# Mobile password recovery. Supported providers: "2factor" and "log" (non-production only).
PASSWORD_RECOVERY_METHOD=email
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=+91
TWO_FACTOR_API_KEY=
