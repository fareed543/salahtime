Options -Indexes

RewriteEngine On

# Canonical URL: HTTPS + non-www + no trailing slash for clean page routes.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.salah-times\.in$ [NC]
RewriteRule ^ https://salah-times.in%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ %1 [R=301,L,NE]

# The mobile prayer layout moved from /all-prayer-times to the /prayer-times URLs.
RewriteRule ^all-prayer-times(/.*)?$ https://salah-times.in/prayer-times$1 [R=301,L,NE]
# Old paths the app only redirects client-side: answer them with a real 301 instead of an indexable shell.
RewriteRule ^salahtime(/.*)?$ https://salah-times.in/prayer-times$1 [R=301,L,NE]
RewriteRule ^dashboard$ https://salah-times.in/ [R=301,L]
RewriteRule ^tasbih$ https://salah-times.in/zikar [R=301,L]

# Prerendered pages (tools/prerender-seo.js) carry each page's own title, canonical and content.
# They are only reachable at their real URLs, never at /prerendered/...
RewriteCond %{THE_REQUEST} \s/+prerendered[/\s?]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ - [R=404,L]
# Only when the prerendered home exists; otherwise "/" falls through to the SPA index.html below
# instead of hitting the final 404 rule (an upload without prerendered/ took the home page down).
RewriteCond %{DOCUMENT_ROOT}/prerendered/index.html -f
RewriteRule ^$ prerendered/index.html [L]
RewriteCond %{DOCUMENT_ROOT}/prerendered/$1.html -f
RewriteRule ^(.+)$ prerendered/$1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Unhashed files (assets/, service-worker.js, manifest) keep their URL across releases,
  # so browsers must revalidate them; the ETag makes that a cheap 304 when nothing changed.
  <FilesMatch "\.(?:css|js|mjs|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|webp|svg|ico|woff2?|mp3|wav|ogg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Angular build output has a content hash in the name, so it never changes: cache it for a year.
  <FilesMatch "\.[0-9a-f]{16,}\.(?:css|js|mjs|png|jpe?g|gif|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^404\.html$ - [L]

# Every real city, country, dua category and Learn topic page is prerendered (and so was served
# above). Any other URL under them is unknown: a real 404, not the app shell with status 200.
# Only when this upload has prerendered pages, so a build without them still works.
# NF-010: only the current and next month are published; another month of a city goes to the city page.
RewriteCond %{DOCUMENT_ROOT}/prerendered/index.html -f
RewriteRule ^prayer-times/([^/]+)/([^/]+)/[a-z]+-[0-9]{4}$ https://salah-times.in/prayer-times/$1/$2 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/prerendered/index.html -f
RewriteRule ^(prayer-times|duas|learn|sehri-iftar)/.+$ - [R=404,L]

# Private pages get the noindex.html shell (tools/prerender-seo.js), so they say noindex in the raw HTML.
RewriteRule ^(settings|report-issue|profile|login|register|forgot-password|verify-password-otp|reset-password|programs|subscription|halqa|area|notifications)$ noindex.html [L]
RewriteRule ^(programs|subscription|halqa|area|users|masjid-display|masjid)/[^/]+$ noindex.html [L]
RewriteRule ^blog/(write|my-articles)(/[^/]+)?$ noindex.html [L]

# Only URLs the Angular router knows are served by index.html; everything else is a real 404.
# Keep in sync with the routes (tools/check-spa-routes.js runs on prebuild and fails if a route is missing).
RewriteRule ^(about|privacy-policy|sehri-iftar|zikar|qibla-direction|salah-calendar|zakat-calculator|masjid)$ index.html [L]
# Prayer times: /prayer-times, /<country>, /<country>/<city>, /<country>/<city>/<month>-<year> (NF-010)
RewriteRule ^prayer-times(/[^/]+){0,3}$ index.html [L]
RewriteRule ^learn(/[^/]+){0,2}$ index.html [L]
# Ramadan city pages (NF-009): /sehri-iftar/<country>/<city>
RewriteRule ^sehri-iftar/[^/]+/[^/]+$ index.html [L]
# Blog (NF-003): /blog, /blog/<slug>, /blog/author/<id>
RewriteRule ^blog(/[^/]+){0,2}$ index.html [L]
RewriteRule ^duas(/[^/]+){0,2}$ index.html [L]
# Prayer pages (CR-006): /asr-time and /asr-time/<country>/<city>
RewriteRule ^(fajr|dhuhr|asr|maghrib|isha|ishraq|chasht|zawal|tahajjud)-time(/[^/]+/[^/]+)?$ index.html [L]
# Public masjid pages: /masjid/<city>/<masjid-name>
RewriteRule ^masjid/[^/]+/[^/]+$ index.html [L]
RewriteRule ^ - [R=404,L]
