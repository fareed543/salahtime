Options -Indexes

RewriteEngine On

# Canonical URL: HTTPS + non-www + no trailing slash for clean page routes.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.salah-times\.in$ [NC]
RewriteRule ^ https://salah-times.in%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ %1 [R=301,L,NE]

# The mobile prayer layout moved from /all-prayer-times to the /prayer-times URLs.
RewriteRule ^all-prayer-times(/.*)?$ https://salah-times.in/prayer-times$1 [R=301,L,NE]

# Prerendered pages (tools/prerender-seo.js) carry each page's own title, canonical and content.
# They are only reachable at their real URLs, never at /prerendered/...
RewriteCond %{THE_REQUEST} \s/+prerendered[/\s?]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ - [R=404,L]
RewriteRule ^$ prerendered/index.html [L]
RewriteCond %{DOCUMENT_ROOT}/prerendered/$1.html -f
RewriteRule ^(.+)$ prerendered/$1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Unhashed files (assets/, service-worker.js, manifest) keep their URL across releases,
  # so browsers must revalidate them; the ETag makes that a cheap 304 when nothing changed.
  <FilesMatch "\.(?:css|js|mjs|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|gif|webp|svg|ico|woff2?|mp3|wav|ogg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Angular build output has a content hash in the name, so it never changes: cache it for a year.
  <FilesMatch "\.[0-9a-f]{16,}\.(?:css|js|mjs|png|jpe?g|gif|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^404\.html$ - [L]

# Only URLs the Angular router knows are served by index.html; everything else is a real 404.
# Keep in sync with the routes (tools/check-spa-routes.js runs on prebuild and fails if a route is missing).
RewriteRule ^(dashboard|about|privacy-policy|settings|sehri-iftar|zikar|tasbih|qibla-direction|salah-calendar|zakat-calculator|programs|subscription|masjid|halqa|area|profile|login|register|forgot-password|verify-password-otp|reset-password|salahtime)$ index.html [L]
RewriteRule ^(prayer-times|learn)(/[^/]+){0,2}$ index.html [L]
RewriteRule ^duas(/[^/]+)?$ index.html [L]
RewriteRule ^(programs|subscription|masjid|halqa|area|users|masjid-display|salahtime)/[^/]+$ index.html [L]
# Public masjid pages: /masjid/<city>/<masjid-name>
RewriteRule ^masjid/[^/]+/[^/]+$ index.html [L]
RewriteRule ^ - [R=404,L]
