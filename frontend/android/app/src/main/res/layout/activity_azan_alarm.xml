<?xml version="1.0" encoding="utf-8"?>
<!-- CR-017 full-screen azan alarm: big time, prayer name, city, one Stop button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1F1C"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_round" />

    <TextClock
        android:id="@+id/azan_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="#E6ECEA"
        android:textSize="96sp" />

    <TextView
        android:id="@+id/azan_alarm_prayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/azan_alarm_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#9FB5AF"
        android:textSize="18sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/azan_alarm_stop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/azan_alarm_stop_button"
        android:stateListAnimator="@null"
        android:text="@string/azan_alarm_stop"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />
</LinearLayout>
